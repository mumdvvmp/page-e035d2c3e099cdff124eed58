or:var(--grey);letter-spacing:.06em}\n  h1{font-size:clamp(34px,6.4vw,62px);font-weight:900;letter-spacing:-.02em;margin-bottom:18px}\n  h1 em{font-style:normal;background:var(--orange);color:#fff;padding:0 .12em;box-decoration-break:clone;-webkit-box-decoration-break:clone}\n  .hero-lede{max-width:640px;font-size:16.5px;color:#2c2c2c;margin-bottom:34px}\n  .hero-lede strong{color:var(--orange)}\n\n  .dash{display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:14px}\n  .cell{border:2px solid var(--ink);padding:16px 16px 14px;background:#fff}\n  .cell.accent{background:var(--orange);border-color:var(--orange);color:#fff}\n  .cell.wash{background:var(--wash)}\n  .cell .k{display:block;font-size:11.5px;letter-spacing:.14em;font-weight:700;margin-bottom:8px;opacity:.78}\n  .cell .v{display:block;font-size:29px;font-weight:900;letter-spacing:-.02em;line-height:1.1}\n  .cell .v small{font-size:13px;font-weight:700;letter-spacing:0;margin-left:2px}\n  .cell .sub{display:block;font-size:12px;margin-top:6px;opacity:.8;line-height:1.5}\n  .cell.wide{grid-column:span 2}\n  @media (max-width:640px){ .cell.wide{grid-column:span 1} }\n\n  /* 通用区块 */\n  section{padding:56px 0;border-bottom:2px solid var(--ink)}\n  section:last-of-type{border-bottom:none}\n  .sec-head{margin-bottom:28px}\n  .sec-head .eyebrow{display:inline-block;font-size:11.5px;letter-spacing:.22em;font-weight:800;color:var(--orange);margin-bottom:10px}\n  h2{font-size:clamp(23px,3.4vw,31px);font-weight:900;letter-spacing:-.01em}\n  .sec-head p{margin-top:12px;max-width:620px;color:#3a3a3a;font-size:15.5px}\n\n  /* 使用说明步骤 */\n  .steps{display:grid;gap:16px;grid-template-columns:repeat(auto-fit,minmax(260px,1fr))}\n  .step{border:2px solid var(--ink);padding:22px 20px;position:relative}\n  .step .num{display:inline-block;font-size:12px;font-weight:900;letter-spacing:.14em;background:var(--ink);color:#fff;padding:3px 9px;margin-bottom:14px}\n  .step h3{font-size:17.5px;font-weight:800;margin-bottom:8px}\n  .step p{font-size:14.5px;color:#3a3a3a}\n\n  .callout{margin-top:22px;border:2px solid var(--ink);border-left-width:10px;border-left-color:var(--orange);padding:16px 20px;font-size:14.5px;background:var(--wash)}\n  .callout b{color:var(--orange)}\n\n  /* 套餐：横向对比表格 */\n  .table-wrap{width:100%;overflow-x:auto;border:2px solid var(--ink);background:#fff}\n  table{width:100%;min-width:680px;border-collapse:collapse;font-size:14.5px}\n  caption{caption-side:top;text-align:left;font-size:13px;color:var(--grey);padding:12px 16px;border-bottom:2px solid var(--ink);background:var(--wash)}\n  th,td{padding:14px 16px;text-align:left;border-bottom:1px solid #d8d4cf;vertical-align:top}\n  thead th{border-bottom:2px solid var(--ink);font-size:13px;letter-spacing:.06em;background:#fff;white-space:nowrap}\n  thead th .plan-name{display:block;font-size:16px;font-weight:900;letter-spacing:0}\n  thead th .plan-price{display:block;margin-top:6px;font-size:20px;font-weight:900;color:var(--orange);letter-spacing:-.01em}\n  thead th .plan-price small{font-size:12px;color:var(--grey);font-weight:700;margin-left:2px}\n  thead th .plan-year{display:block;font-size:12px;color:var(--grey);margin-top:2px;font-weight:600}\n  thead th.pick{background:var(--orange-soft);box-shadow:inset 0 3px 0 var(--orange)}\n  thead th.pick::after{content:\"推荐\";display:inline-block;margin-top:6px;font-size:11px;font-weight:900;letter-spacing:.1em;color:#fff;background:var(--orange);padding:2px 7px}\n  tbody th{font-weight:700;color:#2c2c2c;background:var(--wash);white-space:nowrap;font-size:13.5px}\n  tbody tr:last-child th,tbody tr:last-child td{border-bottom:none}\n  td.yes{font-weight:700}\n  td .tick{color:var(--orange);font-weight:900;margin-right:5px}\n\n  /* FAQ 双栏问答 */\n  .faq-grid{display:grid;gap:16px;grid-template-columns:repeat(auto-fit,minmax(280px,1fr))}\n  .qa{border:2px solid var(--ink);padding:20px;background:#fff}\n  .qa h3{font-size:16px;font-weight:800;margin-bottom:8px;padding-left:30px;position:relative}\n  .qa h3::before{content:\"Q\";position:absolute;left:0;top:-1px;font-size:13px;font-weight:900;color:#fff;background:var(--orange);width:21px;height:21px;line-height:21px;text-align:center}\n  .qa p{font-size:14.5px;color:#3a3a3a;padding-left:30px}\n\n  /* 页脚 */\n  footer{padding:44px 0 64px}\n  .foot-inner{border-top:2px solid var(--ink);padding-top:22px;display:flex;flex-wrap:wrap;justify-content:space-between;gap:14px;font-size:13px;color:var(--grey)}\n  .foot-inner strong{color:var(--ink)}\n\n  @media (max-width:860px){\n    .shell{display:block;padding:0 18px}\n    .rail{width:auto;position:static;min-height:0;border-right:none;border-bottom:2px solid var(--ink);padding:22px 0 18px}\n    .rail .mark{margin-bottom:14px;padding-bottom:12px}\n    .rail ol{display:flex;flex-wrap:wrap;gap:8px 18px}\n    .rail li{margin:0}\n    .rail .note{display:none}\n    .stage{padding:28px 0 56px}\n  }\n</style><div class=\"shell\">\n\n  <nav class=\"rail\" aria-label=\"页面目录\">\n    <span class=\"mark\">白嫖<span>机场</span></span>\n    <ol>\n      <li><a href=\"#hero\">概览</a></li>\n      <li><a href=\"#howto\">怎么用</a></li>\n      <li><a href=\"#plans\">套餐对比</a></li>\n      <li><a href=\"#clients\">客户端</a></li>\n      <li><a href=\"#faq\">常见问题</a></li>\n    </ol>\n    <p class=\"note\">这一页把参数摆清楚，剩下的你自己比。价格与额度以下方表格为准。</p>\n  </nav>\n\n  <main class=\"stage\">\n\n    \n    <section class=\"hero\" id=\"hero\">\n      <div class=\"hero-top\">\n        <span class=\"tagline\">Plans · Usage · Setup</span>\n        <span class=\"stamp\">白嫖机场 · 一页说明</span>\n      </div>\n\n      <h1>白嫖机场：<br>先看<em>额度</em>，再谈价格</h1>\n\n      <p class=\"hero-lede\">\n        很多朋友一上来就问哪档最划算。其实更该先问自己三件事：一个月用掉多少流量、几台设备同时在用、要不要稳定的专线。\n        这张页面把这些数字摊开，你对着看一遍，答案基本就出来了。<strong>下面四块数据</strong>是整个方案的骨架。\n      </p>\n\n      <div class=\"dash\">\n        <div class=\"cell accent\">\n          <span class=\"k\">起步档 / 月</span>\n          <span class=\"v\">¥15</span>\n          <span class=\"sub\">100GB 流量 · 3 台设备</span>\n        </div>\n        <div class=\"cell\">\n          <span class=\"k\">中间档 / 月</span>\n          <span class=\"v\">¥35</span>\n          <span class=\"sub\">300GB 流量 · 5 台设备</span>\n        </div>\n        <div class=\"cell\">\n          <span class=\"k\">团队档 / 月</span>\n          <span class=\"v\">¥85</span>\n          <span class=\"sub\">1000GB 流量 · 20 台设备</span>\n        </div>\n        <div class=\"cell wash\">\n          <span class=\"k\">年付折扣</span>\n          <span class=\"v\">≈10<small>个月</small></span>\n          <span class=\"sub\">三档均按年付折算约十个月价</span>\n        </div>\n        <div class=\"cell wide wash\">\n          <span class=\"k\">选中档位前，先算一笔账</span>\n          <span class=\"sub\">\n            单人手机 + 电脑同时在线，100GB 通常够日常网页与视频；有平板、电视盒子、多口人共用，直接看 300GB 那栏更省心。\n          </span>\n        </div>\n      </div>\n    </section>\n\n    \n    <section id=\"howto\">\n      <div class=\"sec-head\">\n        <span class=\"eyebrow\">Step by Step</span>\n        <h2>从下单到正常用起来，四步</h2>\n        <p>顺序别乱，大部分\"连不上\"的问题都出在第二步——订阅链接没更新就直接改配置。</p>\n      </div>\n\n      <div class=\"steps\">\n        <article class=\"step\">\n          <span class=\"num\">STEP 01</span>\n          <h3>选档并确认用量</h3>\n          <p>先算家里同时在线的设备数量，再对照下表挑档位。不确定就从上一档起步，流量用超和换档之间的取舍后面 FAQ 里讲。</p>\n        </article>\n        <article class=\"step\">\n          <span class=\"num\">STEP 02</span>\n          <h3>拿到订阅并导入客户端</h3>\n          <p>把订阅地址复制到客户端的\"订阅\"栏，先更新一次节点列表，再选择延迟较低的那个。别急着改其他设置。</p>\n        </article>\n        <article class=\"step\">\n          <span class=\"num\">STEP 03</span>\n          <h3>按设备适配参数</h3>\n          <p>手机端通常开全局即可；桌面端建议先按规则分流跑两天，遇到打不开的站点再单独往代理里加。</p>\n        </article>\n        <article class=\"step\">\n          <span class=\"num\">STEP 04</span>\n          <h3>观察一周再决定续费档</h3>\n          <p>用满一周后回看后台的流量曲线。如果月底还剩一半以上，说明下一周期可以降到低一档，没必要一直付高档位的钱。</p>\n        </article>\n      </div>\n\n      <p class=\"callout\">\n        <b>提醒一句：</b>订阅地址属于你的账号凭证，别整段发到群里或截图分享，换设备时重新复制一次更稳妥。\n      </p>\n    </section>\n\n    \n    <section id=\"plans\">\n      <div class=\"sec-head\">\n        <span class=\"eyebrow\">Plans</span>\n        <h2>三档横向摆一起，逐项比</h2>\n        <p>同一行是同一种能力，往下读就能看出差在哪。年付价格为折算后的总额，具体以你实际下单页显示为准。</p>\n      </div>\n\n      <div class=\"table-wrap\">\n        <table>\n          白嫖机场套餐对比 · 月付与年付折算并列，权益以本表为准\n          <thead>\n            <tr>\n              <th>对比项</th>\n              <th>\n                <span class=\"plan-name\">基础版</span>\n                <span class=\"plan-price\">¥15<small>/月</small></span>\n                <span class=\"plan-year\">年付 ¥150 / 年</span>\n              </th>\n              <th class=\"pick\">\n                <span class=\"plan-name\">旗舰版</span>\n                <span class=\"plan-price\">¥35<small>/月</small></span>\n                <span class=\"plan-year\">年付 ¥350 / 年</span>\n              </th>\n              <th>\n                <span class=\"plan-name\">团队版</span>\n                <span class=\"plan-price\">¥85<small>/月</small></span>\n                <span class=\"plan-year\">年付 ¥850 / 年</span>\n              </th>\n            </tr>\n          </thead>\n          <tbody>\n            <tr>\n              <th>每月流量</th>\n              <td>100GB</td>\n              <td>300GB</td>\n              <td>1000GB</td>\n            </tr>\n            <tr>\n              <th>同时在线设备</th>\n              <td>3 台</td>\n              <td>5 台</td>\n              <td>20 台</td>\n            </tr>\n            <tr>\n              <th>流媒体解锁</th>\n              <td>基础流媒体解锁</td>\n              <td>全节点原生流媒体解锁</td>\n              <td>全节点原生流媒体解锁</td>\n            </tr>\n            <tr>\n              <th>线路类型</th>\n              <td>普通线路节点池</td>\n              <td>含 IPLC 专线，游戏加速优化</td>\n              <td>VIP 专属高带宽节点</td>\n            </tr>\n            <tr>\n              <th>路由定制</th>\n              <td>—</td>\n              <td>—</td>\n              <td>支持企业定制路由</td>\n            </tr>\n            <tr>\n              <th>支持与服务</th>\n              <td>标准工单</td>\n              <td>7x24 优先工单支持</td>\n              <td>专属客户经理服务</td>\n            </tr>\n            <tr>\n              <th>适合谁</th>\n              <td>一个人，手机加电脑</td>\n              <td>多设备家庭用户、有观影和游戏需求</td>\n              <td>小团队共用、需要独立线路规划</td>\n            </tr>\n          </tbody>\n        </table>\n      </div>\n\n      <p class=\"callout\">\n        <b>怎么选不后悔：</b>设备数先卡上限——超过 3 台就直接排除基础版；再看流量，观影多的往中间档走。\n        团队版的价值主要落在人数与线路定制上，单人用不到就别为它多付钱。\n      </p>\n    </section>\n\n    \n    <section id=\"clients\">\n      <div class=\"sec-head\">\n        <span class=\"eyebrow\">Clients</span>\n        <h2>客户端这一块，说实话</h2>\n        <p>页面不提供下载地址，也不指定哪款才是\"官方\"。你手上现成的客户端大多能用，关键是会导入订阅、会刷新节点。</p>\n      </div>\n\n      <div class=\"steps\">\n        <article class=\"step\">\n          <span class=\"num\">桌面</span>\n          <h3>Windows / macOS</h3>\n          <p>选一款支持订阅导入与规则分流的客户端即可。装完先只做两件事：粘贴订阅、点击更新。其余设置保持默认，跑顺了再动。</p>\n        </article>\n        <article class=\"step\">\n          <span class=\"num\">移动</span>\n          <h3>iOS / Android</h3>\n          <p>iOS 端通常需要配合对应区域的账号从应用商店获取，Android 端多为直接安装。两端都以\"能读订阅链接\"为最低要求。</p>\n        </article>\n        <article class=\"step\">\n          <span class=\"num\">旁路</span>\n          <h3>路由器与其他设备</h3>\n          <p>如果你想让电视、游戏机一起走代理，可以在路由器上配置。这一档对动手能力有要求，先把单机跑通再折腾全屋。</p>\n        </article>\n      </div>\n\n      <p class=\"callout\">\n        <b>一句实话：</b>本页不列出具体下载链接，因为来源一旦不确定，装到修改版客户端反而更麻烦。请通过你信任的渠道获取安装包。\n      </p>\n    </section>\n\n    \n    <section id=\"faq\">\n      <div class=\"sec-head\">\n        <span class=\"eyebrow\">FAQ</span>\n        <h2>大家真正会问的几个问题</h2>\n        <p>挑的都是下单前后最常撞上的，答案按实际情况写，不做夸大。</p>\n      </div>\n\n      <div class=\"faq-grid\">\n        <article class=\"qa\">\n          <h3>流量用超了会怎样？</h3>\n          <p>超出当月额度后通常会被限速或暂停，具体以账号后台的提示为准。最省事的做法是月底看一次剩余流量，长期不够就升一档，长期用不完就降一档。</p>\n        </article>\n\n        <article class=\"qa\">\n          <h3>三台设备和五台设备，区别在哪？</h3>\n          <p>指同一时间保持连接的数量上限，不是总授权数。你可以有更多设备，但同时开着的超过上限时，后连上的可能会被挤掉。</p>\n        </article>\n\n        <article class=\"qa\">\n          <h3>年付一定比月付划算吗？</h3>\n          <p>按本页的折算价，三档年付都相当于十个月的月付金额。但前提是你确定会用满一年。首次尝试建议先月付跑一个周期再决定。</p>\n        </article>\n\n        <article class=\"qa\">\n          <h3>IPLC 专线到底改善了哪部分体验？</h3>\n          <p>主要体现在链路稳定性和延迟表现上，对实时对战类游戏、长时间视频会议更友好。日常网页浏览的差别不会太明显，别为它单独付溢价。</p>\n        </article>\n\n        <article class=\"qa\">\n          <h3>换设备需要重新设置吗？</h3>\n          <p>要，但只是重新导入一次订阅。旧设备记得退出或断连，否则会占住同时在线的名额，让新设备连不上。</p>\n        </article>\n\n        <article class=\"qa\">\n          <h3>流媒体解锁指的是什么？</h3>\n          <p>指在部分节点上访问流媒体平台时可获得更接近原生地区的体验。基础版为基础解锁，旗舰版与团队版为全节点原生解锁。是否成功仍受平台策略变化影响。</p>\n        </article>\n\n        <article class=\"qa\">\n          <h3>连上了但网页打不开，先查什么？</h3>\n          <p>按这个顺序：节点列表是否最新、当前节点延迟是否正常、客户端是否处于代理模式。三步都排除之后，再考虑换一个节点重试。</p>\n        </article>\n\n        <article class=\"qa\">\n          <h3>团队版能开多少人？</h3>\n          <p>页面上给的是 20 台设备同时在线，以及企业定制路由和专属客户经理。具体怎么分配名额、怎么规划线路，需要和客户经理对一次实际需求。</p>\n        </article>\n      </div>\n    </section>\n\n    <footer>\n      <div class=\"foot-inner\">\n        <span><strong>白嫖机场</strong> · 套餐、额度与使用说明</span>\n        <span>价格与权益以本页表格与账号后台为准 · 页面内容随产品调整而更新</span>\n      </div>\n    </footer>\n\n  </main>\n</div>",
